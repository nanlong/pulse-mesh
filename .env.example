AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_ALLOWED_MODELS=deepseek-v4-flash
AI_RESPONSE_FORMAT=json_object
TARGET_REPOSITORY=owner/site-repo
TARGET_REPO_TOKEN=
SOURCE_URLS="https://www.coindesk.com/arc/outboundfeeds/rss/
https://cointelegraph.com/rss
https://decrypt.co/feed
https://www.theblock.co/rss.xml
https://www.sec.gov/news/pressreleases.rss
https://www.cftc.gov/RSS/RSSGP/rssgp.xml
https://www.cftc.gov/RSS/RSSENF/rssenf.xml
https://blog.ethereum.org/feed.xml
https://bitcoinops.org/feed.xml
https://www.chainalysis.com/blog/feed/
https://solana.com/rss.xml
https://slowmist.medium.com/feed"
CONTENT_INSTRUCTIONS=关注加密行业的重要政策、协议升级、安全事件和市场结构变化，忽略价格喊单、重复转载和低价值营销内容。
GATE_PROMPT="你是生产内容发布审核器，只判断是否值得公开发布，不写文章。必须确认来源真实可核验、内容有具体事实和行业信息增量，并拒绝测试、演示、fixture、placeholder、烟雾测试、管道验证、内部日志、营销、价格喊单、传闻、重复转载和证据不足内容。example.test、example.com、localhost、127.0.0.1 等保留测试地址不得作为生产来源。只能依据候选及来源判断，返回严格 JSON。"
ARTICLE_PROMPT="你是生产级加密行业编辑。只使用 Gate 已通过的候选和来源 URL，生成事实准确、信息密度足够、可公开发布的 Markdown 文章。标题和摘要不得夸大，正文区分事实与推断，不补充候选之外的事实、引语、数字或来源，不提供投资建议，不输出测试、演示、fixture、placeholder 或管道验证内容。返回严格 JSON。"
OUTPUT_LANGUAGES=zh-CN
PUBLISH_THRESHOLD=0.75
TARGET_BRANCH=main
MAX_ITEM_AGE_HOURS=24
MAX_CANDIDATES_PER_RUN=20
MAX_DECISION_RECORDS=1000
MINIMUM_CONTENT_LENGTH=40
STATE_PATH=state/decisions.json
TEMPLATE_DIR=template/editorial
SITE_NAME=PulseMesh
SITE_DESCRIPTION="经过筛选、核验和语言生成的加密行业资讯。"
SITE_TAGLINE="先看事实，再看叙事。"
SITE_LOCALE=zh-CN
SITE_PUBLISHER_NAME=PulseMesh
SITE_AUTHOR_NAME="PulseMesh 编辑部"
SITE_CONTACT_URL=
SITE_AI_DISCLOSURE="内容由自动化流程辅助整理，保留可核验来源；事实、来源观点与推断应明确区分。"
SITE_SOCIAL_IMAGE_URL=
SITE_NEWSLETTER_URL=
SITE_SPONSOR_URL=
SITE_THEME=midnight
SITE_PRIMARY_COLOR="#8b5cf6"
SITE_ACCENT_COLOR="#22d3ee"
SITE_BACKGROUND_COLOR="#080d18"
SITE_SURFACE_COLOR="#111827"
SITE_TEXT_COLOR="#e5eefb"
SITE_MUTED_COLOR="#94a3b8"
SITE_MAX_WIDTH=1180px
SITE_CARD_RADIUS=20px
SITE_ARTICLE_TITLE_MAX_SIZE=2.8rem
SITE_SHOW_TOPICS=true
SITE_SHOW_SCORE=false
SITE_SHOW_SOURCES=true
SITE_FOOTER_TEXT="PulseMesh · Signal over noise."
