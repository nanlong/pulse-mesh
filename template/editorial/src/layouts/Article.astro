---
interface Translation {
  language: string
  href: string
}

interface Props {
  title: string
  summary: string
  language: string
  kind?: 'website' | 'article' | 'page'
  publishedAt?: Date
  modifiedAt?: Date
  topics?: string[]
  translations?: Translation[]
}

import '../styles/global.css'
import { siteConfig } from '../data/site-config'
import { uiFor } from '../data/ui'

const {
  title,
  summary,
  language,
  kind = 'page',
  publishedAt,
  modifiedAt = publishedAt,
  topics = [],
  translations = [],
} = Astro.props
const base = import.meta.env.BASE_URL
const ui = uiFor(language)
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const pageTitle = kind === 'website' ? `${siteConfig.name}｜${siteConfig.tagline}` : `${title}｜${siteConfig.name}`
const socialImageUrl = siteConfig.socialImageUrl || undefined
const themeStyle = [
  `--site-primary:${siteConfig.primaryColor}`,
  `--site-accent:${siteConfig.accentColor}`,
  `--site-background:${siteConfig.backgroundColor}`,
  `--site-surface:${siteConfig.surfaceColor}`,
  `--site-text:${siteConfig.textColor}`,
  `--site-muted:${siteConfig.mutedColor}`,
  `--site-max-width:${siteConfig.maxWidth}`,
  `--site-card-radius:${siteConfig.cardRadius}`,
  `--site-article-title-max-size:${siteConfig.articleTitleMaxSize}`,
].join(';')
const structuredData = kind === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: title,
      description: summary,
      mainEntityOfPage: canonicalUrl.href,
      datePublished: publishedAt?.toISOString(),
      dateModified: modifiedAt?.toISOString(),
      author: { '@type': 'Organization', name: siteConfig.authorName },
      publisher: { '@type': 'Organization', name: siteConfig.publisherName },
      image: socialImageUrl ? [socialImageUrl] : undefined,
      keywords: topics,
      isAccessibleForFree: true,
    }
  : {
      '@context': 'https://schema.org',
      '@type': kind === 'website' ? 'WebSite' : 'WebPage',
      name: title,
      description: summary,
      url: canonicalUrl.href,
      publisher: { '@type': 'Organization', name: siteConfig.publisherName },
    }
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---
<!doctype html>
<html lang={language} data-theme={siteConfig.theme} style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary || siteConfig.description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" href={`${base}rss.xml`} type="application/rss+xml" title={`${siteConfig.name} RSS`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {translations.map((translation) => <link rel="alternate" hreflang={translation.language} href={new URL(translation.href, canonicalUrl)} />)}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={language.replace('-', '_')} />
    <meta property="og:type" content={kind === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary || siteConfig.description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {kind === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {kind === 'article' && modifiedAt && <meta property="article:modified_time" content={modifiedAt.toISOString()} />}
    {kind === 'article' && topics.map((topic) => <meta property="article:tag" content={topic} />)}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={summary || siteConfig.description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={base} aria-label={siteConfig.name}>
          <span class="brand-mark">{siteConfig.name.slice(0, 1).toUpperCase()}</span>
          <span>{siteConfig.name}</span>
        </a>
        <nav aria-label="Primary">
          <a href={base}>{ui.home}</a>
          <a href={`${base}archive/`}>{ui.archive}</a>
          <a href={`${base}about/`}>{ui.about}</a>
          <a href={`${base}rss.xml`}>{ui.rss}</a>
          {siteConfig.newsletterUrl && <a class="nav-action" href={siteConfig.newsletterUrl} rel="noreferrer">{ui.newsletter}</a>}
          {translations.length > 1 && translations.map((translation) => <a href={translation.href} hreflang={translation.language} aria-current={translation.language === language ? 'page' : undefined}>{translation.language}</a>)}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-main"><strong>{siteConfig.footerText}</strong><span>{siteConfig.description}</span></div>
      <nav class="footer-links" aria-label="Footer">
        <a href={`${base}editorial-policy/`}>{ui.editorialPolicy}</a>
        <a href={`${base}corrections/`}>{ui.corrections}</a>
        <a href={`${base}disclosure/`}>{ui.disclosure}</a>
        <a href={`${base}privacy/`}>{ui.privacy}</a>
        {siteConfig.contactUrl && <a href={siteConfig.contactUrl}>{ui.contact}</a>}
        {siteConfig.sponsorUrl && <a href={siteConfig.sponsorUrl} rel="sponsored noreferrer">{ui.sponsor}</a>}
      </nav>
    </footer>
  </body>
</html>
