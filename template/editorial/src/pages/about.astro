---
import InfoPage from '../components/InfoPage.astro'
import { siteConfig } from '../data/site-config'

const chinese = siteConfig.locale.toLowerCase().startsWith('zh')
const title = chinese ? '关于我们' : 'About'
const summary = siteConfig.description
const sections = chinese
  ? [
      { heading: '我们做什么', paragraphs: [`${siteConfig.name} 发布经过来源筛选、证据检查和编辑规则处理的内容。我们的目标是减少噪音，让读者快速理解真正重要的变化。`] },
      { heading: '谁对内容负责', paragraphs: [`发布机构：${siteConfig.publisherName}。署名主体：${siteConfig.authorName}。`, siteConfig.aiDisclosure || '自动化工具可以辅助整理，但不得替代来源核验和公开披露。'] },
      { heading: '联系', paragraphs: [siteConfig.contactUrl ? `问题、建议和纠错请通过本站公布的联系入口提交：${siteConfig.contactUrl}` : '联系入口尚未配置。'] },
    ]
  : [
      { heading: 'What we do', paragraphs: [`${siteConfig.name} publishes content selected from public sources and processed through evidence and editorial checks. Our goal is to reduce noise and explain material changes clearly.`] },
      { heading: 'Accountability', paragraphs: [`Publisher: ${siteConfig.publisherName}. Byline: ${siteConfig.authorName}.`, siteConfig.aiDisclosure || 'Automation may assist production but does not replace source verification and disclosure.'] },
      { heading: 'Contact', paragraphs: [siteConfig.contactUrl ? `Questions and corrections can be submitted through ${siteConfig.contactUrl}` : 'A contact channel has not been configured.'] },
    ]
---
<InfoPage title={title} summary={summary} sections={sections} />
